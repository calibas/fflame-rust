// (offset, count) into POLYCHORA_VERTS per shape id.
fn polychora_range(shape: u32) -> vec2<u32> {
    switch shape {
        case 0u: { return vec2<u32>(0u, 5u); }
        case 1u: { return vec2<u32>(5u, 16u); }
        case 2u: { return vec2<u32>(21u, 8u); }
        case 3u: { return vec2<u32>(29u, 24u); }
        case 4u: { return vec2<u32>(53u, 600u); }
        case 5u: { return vec2<u32>(653u, 120u); }
        default: { return vec2<u32>(21u, 8u); }
    }
}
