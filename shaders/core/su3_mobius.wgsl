// SU(3)-reduced SL(2,C) Mobius group — Roger Bagula, Three_Programs_su3_
// reduction_McMullen_Moebius_Nylander_SU3_reduced_SL2C2_triquasiconformal45
// _16Limit_4.nb. The 8 Gell-Mann matrices are reduced 3x3 -> 2x2 by
// u0[i] = tt.lambda[i].t (tt=[[1,0,1],[a,b,c]]); each is conjugated by the
// fixed triquasiconformal deformation C = dk.s0.qf (dk=[[1+i,1],[1,1-i]],
// s0=[[1,-i],[-i,1]]/sqrt2, qf=rotate(pi/4) — the '45'), then the group is
// {u_i} + {u_i^-1} = 16 elements, normalized to SL(2,C). Packed as pairs:
// entry 2k = (A.re,A.im,B.re,B.im), 2k+1 = (C.re,C.im,D.re,D.im).
const SU3_MOBIUS: array<vec4<f32>, 32> = array<vec4<f32>, 32>(
    vec4<f32>(-4.0000000, 1.0000000, 3.0000000, 3.0000000), vec4<f32>(-3.0000000, 3.0000000, 4.0000000, 1.0000000),
    vec4<f32>(1.0000000, 1.0000000, 1.0000000, 0.0000000), vec4<f32>(1.0000000, 0.0000000, 1.0000000, -1.0000000),
    vec4<f32>(1.5000000, 3.0000000, 2.5000000, -2.0000000), vec4<f32>(2.5000000, 2.0000000, 1.5000000, -3.0000000),
    vec4<f32>(-2.0000000, 5.0000000, 7.0000000, 1.0000000), vec4<f32>(1.0000000, 5.0000000, 6.0000000, -3.0000000),
    vec4<f32>(0.0000000, 3.0000000, 2.0000000, -2.0000000), vec4<f32>(2.0000000, 2.0000000, 0.0000000, -3.0000000),
    vec4<f32>(-5.0000000, -1.0000000, 2.0000000, 5.0000000), vec4<f32>(-4.0000000, 1.0000000, 3.0000000, 3.0000000),
    vec4<f32>(1.0000000, -1.0000000, -1.0000000, 0.0000000), vec4<f32>(-1.0000000, 0.0000000, 1.0000000, 1.0000000),
    vec4<f32>(4.3301270, -1.7320508, -4.3301270, -3.4641016), vec4<f32>(2.5980762, -3.4641016, -4.9074773, -0.5773503),
    vec4<f32>(4.0000000, 1.0000000, -3.0000000, -3.0000000), vec4<f32>(3.0000000, -3.0000000, -4.0000000, 1.0000000),
    vec4<f32>(1.0000000, -1.0000000, -1.0000000, 0.0000000), vec4<f32>(-1.0000000, 0.0000000, 1.0000000, 1.0000000),
    vec4<f32>(1.5000000, -3.0000000, -2.5000000, 2.0000000), vec4<f32>(-2.5000000, -2.0000000, 1.5000000, 3.0000000),
    vec4<f32>(6.0000000, -3.0000000, -7.0000000, -1.0000000), vec4<f32>(-1.0000000, -5.0000000, -2.0000000, 5.0000000),
    vec4<f32>(0.0000000, -3.0000000, -2.0000000, 2.0000000), vec4<f32>(-2.0000000, -2.0000000, 0.0000000, 3.0000000),
    vec4<f32>(3.0000000, 3.0000000, -2.0000000, -5.0000000), vec4<f32>(4.0000000, -1.0000000, -5.0000000, -1.0000000),
    vec4<f32>(1.0000000, 1.0000000, 1.0000000, -0.0000000), vec4<f32>(1.0000000, -0.0000000, 1.0000000, -1.0000000),
    vec4<f32>(-4.9074773, -0.5773503, 4.3301270, 3.4641016), vec4<f32>(-2.5980762, 3.4641016, 4.3301270, -1.7320508),
);

fn su3_cmul(a: vec2<f32>, b: vec2<f32>) -> vec2<f32> {
    return vec2<f32>(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}
fn su3_cdiv(a: vec2<f32>, b: vec2<f32>) -> vec2<f32> {
    let dn = dot(b, b) + 1e-30;
    return vec2<f32>(a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y) / dn;
}
// Mobius generator k (0..15) applied to complex z: (Az+B)/(Cz+D).
fn su3_mobius_apply(k: u32, z: vec2<f32>) -> vec2<f32> {
    let ab = SU3_MOBIUS[2u * k];
    let cd = SU3_MOBIUS[2u * k + 1u];
    let num = su3_cmul(ab.xy, z) + ab.zw;
    let den = su3_cmul(cd.xy, z) + cd.zw;
    return su3_cdiv(num, den);
}
