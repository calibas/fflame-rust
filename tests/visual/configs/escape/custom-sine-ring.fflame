  "escape": {
    "formula": "custom-bbccdbf87b06f1d8",
    "coloring": "custom-45b517c78d610fe6",
    "max_iter": 300,
    "center_re": "-0.55",
    "center_im": "0",
    "zoom_log2": 0.3,
    "bailout": 64.0,
    "custom_formula": {
      "dialect": "ultra_fractal",
      "entry": "SineMandel",
      "source": "SineMandel {\n; A Mandelbrot whose orbit is bent by a sine each step.\ninit:\n  z = 0\nloop:\n  z = sqr(z) + #pixel\n  z = z + @mix * sin(z)\nbailout:\n  |z| < @bailout\ndefault:\n  title = \"Sine Mandelbrot\"\n  float param mix\n    caption = \"Sine mix\"\n    default = 0.25\n    min = 0\n    max = 1\n  endparam\n  float param bailout\n    default = 64\n  endparam\n}"
    },
    "custom_coloring": {
      "dialect": "ultra_fractal",
      "entry": "RingTrap",
      "source": "RingTrap {\n; Distance to a circle, the closest the orbit comes.\ninit:\n  float d = 1e10\nloop:\n  float t = abs(cabs(#z) - @radius)\n  if t < d\n    d = t\n  endif\nfinal:\n  #index = d * @scale + #numiter * 0.004\ndefault:\n  title = \"Ring Trap\"\n  float param radius\n    default = 0.8\n  endparam\n  float param scale\n    default = 1.5\n  endparam\n}"
    }
  }
}