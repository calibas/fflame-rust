# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Test output images
output/

# Benchmark images
benchmark_results/*.png

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# WASM build output
pkg/

.claude

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
__pycache__/
scripts/gen_su_mobius_table/su_custom_init.wgsl

# Visual regression working output — full-size 800x600 renders, ~40 MB per
# run. Only tests/visual/baseline/ (160x120 thumbnails) is tracked.
tests/visual/current/

# Video files. Animation exports land in the project root by default, and
# they are large (tens of MB) — easy to sweep into a commit with `git add
# -A`, painful to remove afterwards.
*.mp4
*.mkv
*.webm
*.mov

# pyfflame (standalone Python crate — its own target dir and artifacts)
python/target/
python/*.pyd
python/**/__pycache__/
python/.pytest_cache/

# Infinite Gallery thin wasm crates (standalone, python/-style)
wasm/*/target/
wasm/*/pkg/

# Probe timings are machine-specific — the report beside them is the
# artefact that travels. Committing these would put a few hundred
# changed numbers in every diff and train people to skip the file.
docs/generated/variation-probe.timings.txt
docs/generated/variation-probe.progress

