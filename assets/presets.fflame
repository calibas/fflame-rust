  {
    "escape": {
      "bailout": 7.0,
      "center_im": "-0.255",
      "center_re": "0",
      "coloring": "custom-41313a8635d840cc",
      "custom_coloring": {
        "dialect": "rhai",
        "entry": "Frothy Basin",
        "source": "// The Frothy Basin colouring: which attractor a pixel's orbit landed on,\n// a band of the palette each, and how soon, a shade within the band --\n// Fractint's colouring of its frothybasin type (Xfractint 20.04p16,\n// common/miscfrac.c, calcfroth's 256-colour branch). Fractint drew it\n// with its froth3 and froth6 maps, a hue to a band; any palette of three\n// (or six) parts reads as they did.\n//\n// The formula's `a` and Mapping decide the lines the orbits land on; a\n// colouring reads only the orbit, so it takes them again: set them as\n// the formula's. A pixel that left, or never landed, takes the solid\n// colour (Fractint's colour 0).\n\nconst PARAMS = #{\n    a: #{ value: 1.028713768218725, caption: \"a\", hint: \"The formula's a\" },\n    mapping: #{ value: 0, caption: \"Mapping\", choices: [\"Once (3 basins)\", \"Twice (6 basins)\"], hint: \"The formula's Mapping\" },\n    shade: #{ value: 0, caption: \"Shade\", choices: [\"By count, to the band's length\", \"By count over the iteration limit\"], hint: \"Fractint's two schemes: the count up to the band's length (85 colours of 256 for three basins), or the count over the whole iteration limit (its alternate colouring)\" },\n};\n\nconst INFO = #{ title: \"Frothy Basin\", region: \"outside\" };\n\n// Which attractor's line `z` has landed on, 1 to 6, or 0 for none:\n// Fractint's test and its numbering, on the formula's lines and marks\n// (frothy-basin.rhai, `froth_landed`).\nfn froth_attractor(z, a, twice) {\n    let close = 1.0e-6;\n    let slope = sqrt(3.0);\n    // Fractint's critical a, 1.0287137682187249: a parameter is kept in\n    // f32, which rounds that value itself just past it, so the test\n    // allows the rounding -- at the default there are three basins.\n    let three = a.abs() <= 1.02871388;\n    let n = if three { if twice { 6 } else { 3 } } else { if twice { 3 } else { 2 } };\n    let k = 0.75 * a * a;\n    let t1 = 0.25 - 0.5 - k;\n    let t2 = t1 * t1 - t1 - k;\n    let t3 = t2 * t2 - t2 - k;\n    let t4 = t3 * t3 - t3 - k;\n    let y0 = a / 2.0;\n    let s = slope / 2.0;\n    let x = z.re;\n    let y = z.im;\n    if (y0 - y).abs() < close && x >= t1 && x <= t2 {\n        if (!twice && n == 2) || (twice && n == 3) {\n            1\n        } else if x <= t3 {\n            1\n        } else if x >= t4 {\n            if twice { 2 } else { 1 }\n        } else {\n            0\n        }\n    } else if (slope * x - a - y).abs() < close && x <= -0.5 * t1 + y0 * s && x >= -0.5 * t2 + y0 * s {\n        if !twice && n == 2 {\n            2\n        } else if twice && n == 3 {\n            3\n        } else if x >= -0.5 * t3 + y0 * s {\n            if twice { 4 } else { 2 }\n        } else if x <= -0.5 * t4 + y0 * s {\n            if twice { 6 } else { 3 }\n        } else {\n            0\n        }\n    } else if (-slope * x - a - y).abs() < close && x <= -0.5 * t1 - y0 * s && x >= -0.5 * t2 - y0 * s {\n        if !twice && n == 2 {\n            2\n        } else if twice && n == 3 {\n            2\n        } else if x >= -0.5 * t3 - y0 * s {\n            if twice { 5 } else { 3 }\n        } else if x <= -0.5 * t4 - y0 * s {\n            if twice { 3 } else { 2 }\n        } else {\n            0\n        }\n    } else {\n        0\n    }\n}\n\nfn finish(s, z, p, ctx) {\n    let twice = p.mapping == 1;\n    let basin = froth_attractor(z, p.a, twice);\n    // Fractint's bands: 255 colours over at least three, its two- and\n    // three-basin pictures alike; a pixel's shade the count, at least 1.\n    let three = p.a.abs() <= 1.02871388;\n    let bands = if three && twice { 6.0 } else { 3.0 };\n    let shades = if bands == 6.0 { 42.0 } else { 85.0 };\n    let n = to_float(ctx.numiter);\n    let count = if p.shade == 0 {\n        if n > shades { shades } else { n }\n    } else {\n        (shades * n / to_float(ctx.maxiter)).floor()\n    };\n    let shade = if count < 1.0 { 1.0 } else { count };\n    if basin == 0 {\n        #{ index: 0.0, solid: true }\n    } else {\n        #{ index: (shade + shades * to_float(basin - 1)) / 256.0, solid: false }\n    }\n}\n"
      },
      "custom_formula": {
        "dialect": "rhai",
        "entry": "Frothy Basin",
        "source": "// Frothy Basin, Fractint's type (Wesley Loewer's, after the riddled\n// basins James Alexander drew): z^2 + conj((-1 + a i) z), a map with\n// three attractors -- each settling on one of three lines, y = a/2 and\n// its turns by 120 degrees -- whose basins froth into one another.\n// Ported from Xfractint 20.04p16 (common/miscfrac.c: froth_setup and\n// calcfroth, the floating-point path; the defaults, the view and the\n// bailout from common/fractalp.c).\n//\n// A pixel stops when its orbit lands within 1e-6 of an attractor's line\n// (`froth_landed`, Fractint's test), or leaves the bailout's circle.\n// The test reads the iterate alone -- nothing carried but z -- so deep\n// zoom derives its equations. The Frothy Basin colouring\n// (`frothy-basin-coloring.rhai`) colours the basins as Fractint does;\n// its `a` and Mapping are this formula's, to set alike.\n\nconst PARAMS = #{\n    a: #{ value: 1.028713768218725, caption: \"a\", hint: \"The map's parameter. Up to 1.0287137682 (Fractint's critical value) there are three basins; past it, two\" },\n    mapping: #{ value: 0, caption: \"Mapping\", choices: [\"Once (3 basins)\", \"Twice (6 basins)\"], hint: \"Map once a pass, or twice: twice splits each basin in two (Fractint's first parameter, 1 or 2)\" },\n    bailout: #{ value: 7.0, min: 7.0, caption: \"Bailout\", hint: \"The squared radius past which a pixel has left (at least 7, as Fractint keeps it)\" },\n};\n\nconst INFO = #{ title: \"Frothy Basin\", center: complex(0.0, -0.255), magn: 0.9523809523809523, maxiter: 150 };\n\nfn start(pixel, p, ctx) {\n    #{ z: pixel }\n}\n\n// Whether `z` has landed on an attractor: Fractint's test, which sets\n// marks along the top line by the line's own map -- x^2 - x - 3a^2/4,\n// from its minimum at x = 0.5 -- and turns them 120 degrees either way\n// for the other two lines. Written as one comparison, for `escaped`: a\n// point on a line counts unless it lies between the third and fourth\n// marks, which only a three-basin picture (a at most the critical value)\n// keeps waiting. Which attractor it is, the colouring tells.\nfn froth_landed(z, a) {\n    let close = 1.0e-6;\n    let slope = sqrt(3.0);\n    // Fractint's critical a, 1.0287137682187249: a parameter is kept in\n    // f32, which rounds that value itself just past it, so the test\n    // allows the rounding -- at the default there are three basins.\n    let three = a.abs() <= 1.02871388;\n    let k = 0.75 * a * a;\n    let t1 = 0.25 - 0.5 - k;\n    let t2 = t1 * t1 - t1 - k;\n    let t3 = t2 * t2 - t2 - k;\n    let t4 = t3 * t3 - t3 - k;\n    let y0 = a / 2.0;\n    let s = slope / 2.0;\n    let x = z.re;\n    let y = z.im;\n    let top = (y0 - y).abs() < close && x >= t1 && x <= t2;\n    let right = (slope * x - a - y).abs() < close && x <= -0.5 * t1 + y0 * s && x >= -0.5 * t2 + y0 * s;\n    let left = (-slope * x - a - y).abs() < close && x <= -0.5 * t1 - y0 * s && x >= -0.5 * t2 - y0 * s;\n    (top && (!three || x <= t3 || x >= t4))\n        || (!top && right && (!three || x >= -0.5 * t3 + y0 * s || x <= -0.5 * t4 + y0 * s))\n        || (!top && !right && left && (!three || x >= -0.5 * t3 - y0 * s || x <= -0.5 * t4 - y0 * s))\n}\n\n// One map, z^2 + conj((-1 + a i) z), in Fractint's arithmetic and its\n// order: the orbits are chaotic, and the order of a rounding moves a\n// count.\nfn froth_map(z, a) {\n    let x = z.re;\n    let y = z.im;\n    complex(x * x - y * y - x - a * y, y + ((x + x) * y - a * x))\n}\n\nfn step(s, p) {\n    s.z = froth_map(s.z, p.a);\n    if p.mapping == 1 {\n        s.z = froth_map(s.z, p.a);\n    }\n    s\n}\n\nfn escaped(s, p) {\n    froth_landed(s.z, p.a) || s.z.norm_sqr() > p.bailout\n}\n"
      },
