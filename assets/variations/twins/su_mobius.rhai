00000, -1.0000000, 0.0000000, -1.0000000, 1.0000000, 0.0000000, 0.0000000, 0.7071068, -0.0000000, 0.0000000, -0.0000000, 0.0000000, 0.0000000, -1.4142136, -1.0000000, 1.0000000, 1.0000000, -0.0000000, 1.0000000, -0.0000000, -1.0000000, -1.0000000, -1.0000000, -1.0000000, 1.0000000, -0.0000000, 1.0000000, -0.0000000, -1.0000000, 1.0000000, -1.0000000, -1.0000000, -1.0000000, 0.0000000, -1.0000000, 0.0000000, -1.0000000, 1.0000000, -1.0000000, 1.0000000, -1.0000000, 0.0000000, -1.0000000, 0.0000000, -1.0000000, -1.0000000, 1.0000000, 0.0000000, -0.0000000, 0.0000000, -0.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, -0.0000000, 1.0000000, 1.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 1.0000000, -1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, -0.0000000, 1.0000000, -1.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 1.0000000, 1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, -0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, 0.0000000, 1.0000000, 0.0000000, -1.0000000, 2.0000000, 0.0000000, -0.0000000, -1.0000000, -0.0000000, -1.0000000, 0.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, -2.0000000, 1.0000000, 0.0000000, -1.0000000, -0.0000000, 0.0000000, 0.0000000, 0.0000000, -2.0000000, 1.0000000, 0.0000000, -1.0000000, -0.0000000, 0.0000000, 0.0000000, 2.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 2.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 0.0000000, -1.0000000, -1.0000000, -0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, 1.0000000, 1.0000000, 0.0000000, -1.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, -1.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, -1.0000000, 1.0000000, 0.0000000, -1.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, 1.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, 0.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, -2.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000, 0.0000000, -2.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 2.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 2.0000000, 0.0000000, 0.0000000, 0.0000000, 1.0000000, 0.0000000, -1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, -0.0000000, 1.0000000, 1.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 1.0000000, -1.0000000, 0.0000000, 0.0000000, -1.0000000, 0.0000000, 1.0000000, -0.0000000, 1.0000000, -1.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 1.0000000, 1.0000000, 0.0000000, 0.0000000, 1.0000000, -0.0000000, -1.0000000, 0.0000000, 1.0000000, 0.0000000];
    let t1 = u32(2) * idx;
    let ab = vec4(tbl_su_mobius_base[4 * t1 + 0], tbl_su_mobius_base[4 * t1 + 1], tbl_su_mobius_base[4 * t1 + 2], tbl_su_mobius_base[4 * t1 + 3]);
    let t2 = u32(2) * idx + u32(1);
    let cd = vec4(tbl_su_mobius_base[4 * t2 + 0], tbl_su_mobius_base[4 * t2 + 1], tbl_su_mobius_base[4 * t2 + 2], tbl_su_mobius_base[4 * t2 + 3]);
    [complex(ab.x, ab.y), complex(ab.z, ab.w), complex(cd.x, cd.y), complex(cd.z, cd.w)]
}

fn su_mobius_apply(idx, z, cj, cji) {
    let m = su_matmul(su_matmul(cj, su_base(idx)), cji);
    su_cdiv(su_cmul(m[0], z) + m[1], su_cmul(m[2], z) + m[3])
}

fn su_qmul(a, b) {
    vec4(a.x * b.x - a.y * b.y - a.z * b.z - a.w * b.w, a.x * b.y + a.y * b.x + a.z * b.w - a.w * b.z, a.x * b.z - a.y * b.w + a.z * b.x + a.w * b.y, a.x * b.w + a.y * b.z - a.z * b.y + a.w * b.x)
}

fn su_qinv(a) {
    let n = (a.x * a.x + a.y * a.y + a.z * a.z + a.w * a.w) + 1.0e-30;
    vec4(a.x, -a.y, -a.z, -a.w) / n
}

fn su_mobius_apply3(idx, p3, cj, cji) {
    let m = su_matmul(su_matmul(cj, su_base(idx)), cji);
    let t1 = m[0];
    let qa = vec4(t1.re, t1.im, 0.0, 0.0);
    let t2 = m[1];
    let qb = vec4(t2.re, t2.im, 0.0, 0.0);
    let t3 = m[2];
    let qc = vec4(t3.re, t3.im, 0.0, 0.0);
    let t4 = m[3];
    let qd = vec4(t4.re, t4.im, 0.0, 0.0);
    let q = vec4(p3.x, p3.y, abs(p3.z) + 1.0e-4, 0.0);
    let r = su_qmul(su_qmul(qa, q) + qb, su_qinv(su_qmul(qc, q) + qd));
    vec3(r.x, r.y, r.z)
}

fn variation(z, p, ctx) {
    let color = ctx.color;
    let group = u32(to_float(p.group));
    let avoid = to_float(p.avoid_reversal) > 0.5;
    let theta = p.conj_angle * 0.01745329252;
    let eta = p.conj_hyper * 0.01745329252;
    let delta = p.qc_strength;
    let dc_mode = u32(to_float(p.dc_mode));
    let dc_scale = p.dc_scale;
    let color_speed = p.color_speed;
    let rc = su_group_range(group);
    let cnt = rc[1];
    let half = cnt / u32(2);
    let cj = su_conjugator(theta, eta, delta);
    let cji = su_matinv(cj);
    let k = min(u32(rand() * to_float(cnt)), cnt - u32(1));
    if (avoid) {
        let prev = u32(this.st0);
        if (prev < cnt && k == (prev + half) % cnt) {
            k = (k + u32(1)) % cnt;
        }
    }
    this.st0 = to_float(k);
    if (dc_mode == u32(1)) {
        let creg = this.creg;
        creg = mix(creg, fract((to_float(k) + 0.5) / to_float(cnt) * dc_scale), color_speed);
        this.creg = creg;
        color = creg;
    }
    let out = su_mobius_apply(rc[0] + k, z, cj, cji);
    let symm = u32(to_float(p.symmetry));
    if (symm == u32(1)) {
        if (rand() < 0.5) {
            out = -out;
        }
    } else if (symm == u32(2)) {
        if (rand() < 0.5) {
            out = complex(out.re, -out.im);
        }
    } else if (symm == u32(3)) {
        let r = min(u32(rand() * 4.0), u32(3));
        if (r == u32(1)) {
            out = -out;
        } else if (r == u32(2)) {
            out = complex(out.re, -out.im);
        } else if (r == u32(3)) {
            out = complex(-out.re, out.im);
        }
    }
    #{ z: out, color: color }
}

fn variation3(v, p, ctx) {
    let color = ctx.color;
    let group = u32(to_float(p.group));
    let avoid = to_float(p.avoid_reversal) > 0.5;
    let theta = p.conj_angle * 0.01745329252;
    let eta = p.conj_hyper * 0.01745329252;
    let delta = p.qc_strength;
    let dc_mode = u32(to_float(p.dc_mode));
    let dc_scale = p.dc_scale;
    let color_speed = p.color_speed;
    let rc = su_group_range(group);
    let cnt = rc[1];
    let half = cnt / u32(2);
    let cj = su_conjugator(theta, eta, delta);
    let cji = su_matinv(cj);
    let k = min(u32(rand() * to_float(cnt)), cnt - u32(1));
    if (avoid) {
        let prev = u32(this.st0);
        if (prev < cnt && k == (prev + half) % cnt) {
            k = (k + u32(1)) % cnt;
        }
    }
    this.st0 = to_float(k);
    if (dc_mode == u32(1)) {
        let creg = this.creg;
        creg = mix(creg, fract((to_float(k) + 0.5) / to_float(cnt) * dc_scale), color_speed);
        this.creg = creg;
        color = creg;
    }
    let gidx = rc[0] + k;
    let space = u32(to_float(p.space));
    let out = vec3(0.0, 0.0, 0.0);
    if (space == u32(1)) {
        out = su_mobius_apply3(gidx, v, cj, cji);
    } else {
        let t1 = su_mobius_apply(gidx, complex(v.x, v.y), cj, cji);
        out = vec3(t1.re, t1.im, v.z);
    }
    let symm = u32(to_float(p.symmetry));
    if (symm == u32(1)) {
        if (rand() < 0.5) {
            out = vec3(-out.x, -out.y, out.z);
        }
    } else if (symm == u32(2)) {
        if (rand() < 0.5) {
            out = vec3(out.x, -out.y, out.z);
        }
    } else if (symm == u32(3)) {
        let r = min(u32(rand() * 4.0), u32(3));
        if (r == u32(1)) {
            out = vec3(-out.x, -out.y, out.z);
        } else if (r == u32(2)) {
            out = vec3(out.x, -out.y, out.z);
        } else if (r == u32(3)) {
            out = vec3(-out.x, out.y, out.z);
        }
    }
    #{ z: out, color: color }
}
