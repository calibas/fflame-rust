        let v = vec4(tbl_polychora_verts[4 * t1 + 0], tbl_polychora_verts[4 * t1 + 1], tbl_polychora_verts[4 * t1 + 2], tbl_polychora_verts[4 * t1 + 3]);
        out[10 + to_int(u32(4) * k)] = v.x;
        out[10 + to_int(u32(4) * k + u32(1))] = v.y;
        out[10 + to_int(u32(4) * k + u32(2))] = v.z;
        out[10 + to_int(u32(4) * k + u32(3))] = v.w;
    }
    #{ slots: out }
}

fn init(p) {
    #{ creg: 0.0 }
}

fn menger_pick2(rule) {
    for t in 0..12 {
        let i = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let j = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let zeros = 0;
        if (i == 0.0) {
            zeros = zeros + 1;
        }
        if (j == 0.0) {
            zeros = zeros + 1;
        }
        if (zeros <= rule) {
            return complex(i, j);
        }
    }
    complex(1.0, 1.0)
}

fn menger_pick3(rule) {
    for t in 0..12 {
        let i = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let j = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let k = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let zeros = 0;
        if (i == 0.0) {
            zeros = zeros + 1;
        }
        if (j == 0.0) {
            zeros = zeros + 1;
        }
        if (k == 0.0) {
            zeros = zeros + 1;
        }
        if (zeros <= rule) {
            return vec3(i, j, k);
        }
    }
    vec3(1.0, 1.0, 1.0)
}

fn menger_pick4(rule) {
    for t in 0..12 {
        let i = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let j = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let k = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let l = to_float(min(u32(rand() * 3.0), u32(2))) - 1.0;
        let zeros = 0;
        if (i == 0.0) {
            zeros = zeros + 1;
        }
        if (j == 0.0) {
            zeros = zeros + 1;
        }
        if (k == 0.0) {
            zeros = zeros + 1;
        }
        if (l == 0.0) {
            zeros = zeros + 1;
        }
        if (zeros <= rule) {
            return vec4(i, j, k, l);
        }
    }
    vec4(1.0, 1.0, 1.0, 1.0)
}

fn variation(z, p, ctx) {
    let color = ctx.color;
    let rule = to_int(to_float(p.rule));
    let size = p.size;
    let steps = to_int(to_float(p.steps));
    let dc_mode = u32(to_float(p.dc_mode));
    let dc_scale = p.dc_scale;
    let color_speed = p.color_speed;
    let q = z;
    let creg = this.creg;
    let code = 0.0;
    for s in 0..steps {
        let cell = menger_pick2(rule);
        q = q / 3.0 + (2.0 * size / 3.0) * cell;
        code = ((cell.re + 1.0) * 3.0 + (cell.im + 1.0) + 0.5) / 9.0;
        if (dc_mode == u32(1)) {
            creg = mix(creg, fract(code * dc_scale), color_speed);
        }
    }
    if (dc_mode == u32(1)) {
        this.creg = creg;
        color = creg;
    } else if (dc_mode == u32(2)) {
        color = fract(code * dc_scale);
    }
    #{ z: q, color: color }
}

fn variation3(pt, p, ctx) {
    let color = ctx.color;
    let w_out = 0.0;
    let dim = u32(to_float(p.dim));
    let rule = to_int(to_float(p.rule));
    let size = p.size;
    let steps = to_int(to_float(p.steps));
    let dc_mode = u32(to_float(p.dc_mode));
    let dc_scale = p.dc_scale;
    let color_speed = p.color_speed;
    if (dim == u32(0)) {
        let q = pt;
        let creg = this.creg;
        let code = 0.0;
        for s in 0..steps {
            let cell = menger_pick3(rule);
            q = q / 3.0 + (2.0 * size / 3.0) * cell;
            code = (((cell.x + 1.0) * 3.0 + (cell.y + 1.0)) * 3.0 + (cell.z + 1.0) + 0.5) / 27.0;
            if (dc_mode == u32(1)) {
                creg = mix(creg, fract(code * dc_scale), color_speed);
            }
        }
        w_out = ctx.w;
        if (dc_mode == u32(1)) {
            this.creg = creg;
            color = creg;
        } else if (dc_mode == u32(2)) {
            color = fract(ctx.w * dc_scale);
        }
        return #{ z: q, color: color, w: w_out };
    }
    if (dim == u32(2)) {
        let rc = polychora_menger4gap_range();
        let k = 0.18761726;
        let q = pt;
        let creg = this.creg;
        let code = 0.0;
        for st in 0..steps {
            let idx = min(u32(rand() * to_float(rc[1])), rc[1] - u32(1));
            let v = vec4(p.slots[to_int(u32(10) + u32(4) * idx)], p.slots[to_int(u32(11) + u32(4) * idx)], p.slots[to_int(u32(12) + u32(4) * idx)], p.slots[to_int(u32(13) + u32(4) * idx)]);
            q = k * q + (1.0 - k) * size * vec3(v.x, v.y, v.z);
            code = (to_float(idx) + 0.5) / to_float(rc[1]);
            if (dc_mode == u32(1)) {
                creg = mix(creg, fract(code * dc_scale), color_speed);
            }
        }
        w_out = ctx.w;
        if (dc_mode == u32(1)) {
            this.creg = creg;
            color = creg;
        } else if (dc_mode == u32(2)) {
            color = fract(ctx.w * dc_scale);
        }
        return #{ z: q, color: color, w: w_out };
    }
    if (dim == u32(3)) {
        let d2r = 0.01745329252;
        let axw = p.rot_xw * d2r;
        let ayw = p.rot_yw * d2r;
        let azw = p.rot_zw * d2r;
        let cxw = cos(axw);
        let sxw = sin(axw);
        let cyw = cos(ayw);
        let syw = sin(ayw);
        let czw = cos(azw);
        let szw = sin(azw);
        let rc = polychora_menger4gap4d_range();
        let k = 0.18761726;
        let q = vec4(pt.x, pt.y, pt.z, ctx.w);
        let creg = this.creg;
        let code = 0.0;
        for st in 0..steps {
            let idx = min(u32(rand() * to_float(rc[1])), rc[1] - u32(1));
            let v = vec4(p.slots[to_int(u32(10) + u32(4) * idx)], p.slots[to_int(u32(11) + u32(4) * idx)], p.slots[to_int(u32(12) + u32(4) * idx)], p.slots[to_int(u32(13) + u32(4) * idx)]) * size;
            v = vec4(cxw * v.x - sxw * v.w, v.y, v.z, sxw * v.x + cxw * v.w);
            v = vec4(v.x, cyw * v.y - syw * v.w, v.z, syw * v.y + cyw * v.w);
            v = vec4(v.x, v.y, czw * v.z - szw * v.w, szw * v.z + czw * v.w);
            q = k * q + (1.0 - k) * v;
            code = (to_float(idx) + 0.5) / to_float(rc[1]);
            if (dc_mode == u32(1)) {
                creg = mix(creg, fract(code * dc_scale), color_speed);
            }
        }
        w_out = q.w;
        if (dc_mode == u32(1)) {
            this.creg = creg;
            color = creg;
        } else if (dc_mode == u32(2)) {
            color = fract(q.w * dc_scale);
        }
        return #{ z: vec3(q.x, q.y, q.z), color: color, w: w_out };
    }
    let d2r = 0.01745329252;
    let axw = p.rot_xw * d2r;
    let ayw = p.rot_yw * d2r;
    let azw = p.rot_zw * d2r;
    let cxw = cos(axw);
    let sxw = sin(axw);
    let cyw = cos(ayw);
    let syw = sin(ayw);
    let czw = cos(azw);
    let szw = sin(azw);
    let q = vec4(pt.x, pt.y, pt.z, ctx.w);
    let creg = this.creg;
    let code = 0.0;
    for s in 0..steps {
        let cell = menger_pick4(rule);
        let off = (2.0 * size / 3.0) * cell;
        off = vec4(cxw * off.x - sxw * off.w, off.y, off.z, sxw * off.x + cxw * off.w);
        off = vec4(off.x, cyw * off.y - syw * off.w, off.z, syw * off.y + cyw * off.w);
        off = vec4(off.x, off.y, czw * off.z - szw * off.w, szw * off.z + czw * off.w);
        q = q / 3.0 + off;
        code = ((((cell.x + 1.0) * 3.0 + (cell.y + 1.0)) * 3.0 + (cell.z + 1.0)) * 3.0 + (cell.w + 1.0) + 0.5) / 81.0;
        if (dc_mode == u32(1)) {
            creg = mix(creg, fract(code * dc_scale), color_speed);
        }
    }
    w_out = q.w;
    if (dc_mode == u32(1)) {
        this.creg = creg;
        color = creg;
    } else if (dc_mode == u32(2)) {
        color = fract(q.w * dc_scale);
    }
    #{ z: vec3(q.x, q.y, q.z), color: color, w: w_out }
}
