/// Menger sponge / tesseract IFS as a single variation. Each call
/// picks a random kept sub-cell and applies `q' = q/3 + (2/3)*size*cell`,
/// so one transform replaces the whole 20- or 48-transform bank the
/// construction classically needs. The **hole rule** generalizes it: a
/// sub-cell of the 3^d grid is kept iff it has at most `rule` zero
/// coordinates -- `0` keeps only corners (Cantor dust), `1` is the
/// classic sponge, higher values give fatter sponges. `steps` composes
/// several rounds per call, converging onto the attractor far faster
/// for the same iteration budget. The 2D body is the Sierpinski
/// carpet; in 3D with `rot_xw/yw/zw` it is the orthographic shadow of
/// a true 4D tesseract. Original to this project -- no
/// JWildfire/Apophysis counterpart. The module docs carry the full
/// derivation.
///
/// # Authors
/// - Roger Bagula

// Menger, the built-in variation's twin, translated from its WGSL.

const PARAMS = #{
    dim: #{
        value: 0, choices: ["3D Sponge", "4D Tesseract", "Tesseract 4-Gap", "Tesseract 4-Gap 4D"],
        caption: "Dimension",
        hint: "3D Sponge iterates the classic Menger IFS in xyz. 4D Tesseract iterates in xyzw (the 4th coordinate rides the per-thread w register) and plots the orthographic shadow — combine with the XW/YW/ZW rotations to see genuine 4D structure. Tesseract 4-Gap is Roger Bagula's 96-point cube-within-cube construction (nested corner shells + 4 points per edge, contraction 1/5.33) — a 3D fractal that reads like a tesseract projection; Hole Rule and the rotations don't apply to it. Tesseract 4-Gap 4D applies the same recipe to the actual tesseract (224 points in R⁴, original extension) — genuinely 4D, so the XW/YW/ZW rotations and W coloring work. In 2D render mode all give the Sierpinski carpet.",
    },
    rule: #{
        value: 1, min: 0, max: 3,
        caption: "Hole Rule",
        hint: "Maximum zero-coordinates a kept sub-cell may have. 0 = corners only (Cantor dust), 1 = the classic Menger construction, 2+ = fatter sponges where only the most central cells are removed.",
    },
    size: #{
        value: 1.0, min: 0.1, max: 4.0,
        caption: "Size",
        hint: "Half-extent of the fractal: the attractor spans ±size in every axis.",
    },
    steps: #{
        value: 2, min: 1, max: 4,
        caption: "Steps",
        hint: "IFS rounds per call — each round contracts by 1/3 toward a random kept cell. At 2 every iteration contracts by 1/9, sharpening the attractor much faster for the same iteration budget.",
    },
    rot_xw: #{
        value: 0.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate XW",
        hint: "4D Tesseract mode: rotation in the x–w plane, degrees. Rotates the entire 4D attractor before its shadow is taken.",
    },
    rot_yw: #{
        value: 0.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate YW",
        hint: "4D Tesseract mode: rotation in the y–w plane, degrees.",
    },
    rot_zw: #{
        value: 0.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate ZW",
        hint: "4D Tesseract mode: rotation in the z–w plane, degrees.",
    },
    dc_mode: #{
        value: 0, choices: ["Off", "Cell", "W"],
        caption: "Color Mode",
        hint: "Direct-color source (needs the transform's Direct Color > 0). Cell: every internal pick acts like a transform with its own palette position — a persistent per-thread color register blends toward each pick's color at Color Speed, exactly the engine's own color evolution (Color Speed 1 = hard per-cell patches). W: color by the 4th coordinate — the 4D depth strata (4D mode).",
    },
    dc_scale: #{
        value: 1.0, min: 0.1, max: 8.0,
        caption: "Color Scale",
        hint: "Palette-index multiplier for the color modes (wrapped with fract).",
    },
    color_speed: #{
        value: 0.5, min: 0.0, max: 1.0,
        caption: "Color Speed",
        hint: "Cell color mode: how hard each internal pick pulls the running color register toward its own palette position — the engine's per-transform color speed, contained in the variation. Low values = long smooth blends of trajectory history, 1 = hard per-pick assignment (the classic patchwork).",
    },
};

const INFO = #{ title: "Menger", name: "rhai_menger", category: "advanced_2d" };

fn polychora_menger4gap_range() {
    [u32(773), u32(96)]
}

fn polychora_menger4gap4d_range() {
    [u32(869), u32(224)]
}

