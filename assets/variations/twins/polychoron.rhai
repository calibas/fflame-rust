/// Chaos-game gaskets on the regular 4-polytopes (Menger-style IFS on
/// tesseract/16-cell/24-cell/…).
///
/// # Authors
/// - Fractals for All
/// - Claude Fable 5

// Polychoron, the built-in variation's twin, translated from its WGSL.

const PARAMS = #{
    shape: #{
        value: 2, choices: ["5-Cell", "8-Cell (Tesseract)", "16-Cell", "24-Cell", "120-Cell", "600-Cell"],
        caption: "Shape",
        hint: "Which regular 4-polytope's vertices to play the chaos game on. 16-Cell is the hyper-octahedron, 120-Cell the hyper-dodecahedron (600 vertices), 600-Cell the hyper-icosahedron (120 vertices); the 24-Cell is unique to 4D.",
    },
    contraction: #{
        value: 0.3333, min: 0.05, max: 0.9,
        caption: "Contraction",
        hint: "Scale factor per chaos-game round: q' = contraction·q + (1−contraction)·vertex. 1/3 gives the classic gasket; larger values fill toward the solid hull (useful for the vertex-rich 120-Cell), smaller ones scatter toward vertex dust.",
    },
    size: #{
        value: 1.0, min: 0.1, max: 4.0,
        caption: "Size",
        hint: "Circumradius of the polytope.",
    },
    steps: #{
        value: 2, min: 1, max: 4,
        caption: "Steps",
        hint: "Chaos-game rounds per call — sharper attractor for the same iteration budget.",
    },
    rot_xw: #{
        value: 20.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate XW",
        hint: "Rotation in the x–w plane, degrees. Rotates the entire 4D gasket before its shadow is taken — without any 4D rotation, axis-aligned shapes cast degenerate shadows.",
    },
    rot_yw: #{
        value: 12.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate YW",
        hint: "Rotation in the y–w plane, degrees.",
    },
    rot_zw: #{
        value: 7.0, min: -360.0, max: 360.0, type: "angle",
        caption: "Rotate ZW",
        hint: "Rotation in the z–w plane, degrees.",
    },
    dc_mode: #{
        value: 0, choices: ["Off", "Cell", "W"],
        caption: "Color Mode",
        hint: "Direct-color source (needs the transform's Direct Color > 0). Cell: every vertex acts like a transform with its own palette position — a persistent per-thread color register blends toward each pick's color at Color Speed, exactly the engine's own color evolution (Color Speed 1 = hard per-vertex assignment). W: color by the 4th coordinate — depth strata of the 4D shadow.",
    },
    dc_scale: #{
        value: 1.0, min: 0.1, max: 8.0,
        caption: "Color Scale",
        hint: "Palette-index multiplier for the color modes (wrapped with fract).",
    },
    color_speed: #{
        value: 0.5, min: 0.0, max: 1.0,
        caption: "Color Speed",
        hint: "Cell color mode: how hard each internal pick pulls the running color register toward its own palette position — the engine's per-transform color speed, contained in the variation. Low values = long smooth blends of trajectory history, 1 = hard per-pick assignment (the classic patchwork).",
    },
};

const INFO = #{ title: "Polychoron", name: "rhai_polychoron", category: "advanced_2d", slow: ["steps"] };

fn init(p) {
    #{ creg: 0.0 }
}

fn polychora_range(shape) {
    let t1 = shape;
    if t1 == u32(0) {
        [u32(0), u32(5)]
    } else if t1 == u32(1) {
        [u32(5), u32(16)]
    } else if t1 == u32(2) {
        [u32(21), u32(8)]
    } else if t1 == u32(3) {
        [u32(29), u32(24)]
    } else if t1 == u32(4) {
        [u32(53), u32(600)]
    } else if t1 == u32(5) {
        [u32(653), u32(120)]
    } else {
        [u32(21), u32(8)]
    }
}

